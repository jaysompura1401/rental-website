# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → Database
# Use the "Transaction" pooler connection string (port 6543) for serverless/Vercel,
# or the direct connection string (port 5432) for a long-running Node server.
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.otljsnlmmpwwwmerxkcf:DevShah%402367@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ─── Supabase API Keys ────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://otljsnlmmpwwwmerxkcf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# REQUIRED for image upload (server/routes/upload.js) — Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im90bGpzbmxtbXB3d3dtZXJ4a2NmIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Njc5NzQzMSwiZXhwIjoyMTAyMzczNDMxfQ.Qwab7l3ayEk3t4IWTOk4YngjP9K6UPZ82g2QaFmqlPc

# ─── Supabase Storage (property images) ──────────────────────────────────────
# Create a PUBLIC bucket with this exact name in Supabase Dashboard → Storage
SUPABASE_STORAGE_BUCKET=property-images

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# Change this to a long random string before going live
JWT_SECRET=nivaas_super_secret_jwt_key_change_in_production

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─── Your deployed frontend domain (used for CORS) ────────────────────────────
# Example: https://nivaas.com  or  https://yourdomain.com
CLIENT_URL=https://yourdomain.com

# ─── Fast2SMS (Free Indian SMS OTP) ──────────────────────────────────────────
# Sign up free at: https://www.fast2sms.com → Dev API → copy API key
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ─── Twilio (optional alternative) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE=+1234567890
